{
  "version": 1,
  "groups": [
    {
      "id": "source",
      "title": "Source",
      "fields": [
        {
          "key": "sourcePath",
          "type": "string",
          "default": "",
          "maximumLength": 1024,
          "label": "Fichier ItemTracker.json",
          "description": "Vide : détection automatique dans le dossier du randomizer."
        },
        {
          "key": "hideWhenGameClosed",
          "type": "boolean",
          "default": true,
          "label": "Masquer lorsque TUNIC est fermé",
          "description": "Désactiver pour lire un fichier provenant d'un autre ordinateur."
        }
      ]
    },
    {
      "id": "seed",
      "title": "Options de la partie",
      "fields": [
        {
          "key": "swordProgression",
          "type": "boolean",
          "default": true,
          "label": "Épée progressive"
        },
        {
          "key": "abilityShuffling",
          "type": "boolean",
          "default": true,
          "label": "Capacités mélangées"
        },
        {
          "key": "hexagonQuest",
          "type": "boolean",
          "default": false,
          "label": "Hexagon Quest"
        },
        {
          "key": "hexagonGoal",
          "type": "integer",
          "default": 20,
          "minimum": 1,
          "maximum": 100,
          "label": "Hexagones dorés nécessaires"
        }
      ]
    },
    {
      "id": "appearance",
      "title": "Affichage",
      "fields": [
        {
          "key": "widgetEnabled",
          "type": "boolean",
          "default": true,
          "label": "Afficher le tracker"
        },
        {
          "key": "iconSize",
          "type": "integer",
          "default": 48,
          "minimum": 24,
          "maximum": 96,
          "label": "Taille des icônes (px)"
        },
        {
          "key": "gap",
          "type": "integer",
          "default": 8,
          "minimum": 0,
          "maximum": 24,
          "label": "Espacement (px)"
        },
        {
          "key": "missingOpacity",
          "type": "number",
          "default": 0.2,
          "minimum": 0.05,
          "maximum": 0.6,
          "label": "Opacité des objets manquants"
        },
        {
          "key": "showLabels",
          "type": "boolean",
          "default": false,
          "label": "Afficher les noms"
        },
        {
          "key": "showPanels",
          "type": "boolean",
          "default": false,
          "label": "Fond discret derrière les objets"
        },
        {
          "key": "animateAcquisitions",
          "type": "boolean",
          "default": true,
          "label": "Illuminer les nouvelles acquisitions"
        }
      ]
    }
  ]
}
